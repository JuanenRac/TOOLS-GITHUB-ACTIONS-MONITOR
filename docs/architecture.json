{
  "repo": "TOOLS-GITHUB-ACTIONS-MONITOR",
  "ecosystem": "monitor",
  "tagline": "Watches the workflows of every repository you own and tells you, in one page, what is red, what is stuck and what is waiting for you.",
  "description": "GitHub Actions Monitor is a local program. It asks GitHub, through your own authenticated gh client, for the latest runs of every workflow of your repositories, decides what is really red, raises alerts about security, hygiene and releases, shows everything on a web page served only on your own machine in eight languages, and can export the result as files or metrics for a dashboard. Nothing is written to GitHub unless you ask for it.",
  "columns": [
    "WHO USES IT",
    "THE MONITOR",
    "WHAT IT TALKS TO"
  ],
