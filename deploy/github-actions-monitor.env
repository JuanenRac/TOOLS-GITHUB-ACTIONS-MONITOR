# Environment of the service (systemd EnvironmentFile): one NAME=value per line, no quotes, no `export`. Keep it readable by the monitor user only (mode 600).
# The folders: everything the monitor writes goes under /var/lib/github-actions-monitor.
MONITOR_SERVICE=1
MONITOR_CONFIG=/var/lib/github-actions-monitor/actions_monitor.json
MONITOR_CONFIG_DIR=/var/lib/github-actions-monitor
MONITOR_DATA_DIR=/var/lib/github-actions-monitor
MONITOR_ACCOUNTS_DIR=/var/lib/github-actions-monitor/accounts
MONITOR_STATE_DIR=/var/lib/github-actions-monitor/state
MONITOR_SECRET_DIR=/var/lib/github-actions-monitor/secrets
GH_CONFIG_DIR=/var/lib/github-actions-monitor/gh
# The user or organisation to watch (the first account is made from it on the first start)
MONITOR_GITHUB_OWNER=
# The login of GitHub: a file that only the monitor user can read (mode 600), one token on one line; `systemctl reload` reads it again
GH_TOKEN_FILE=/etc/github-actions-monitor/gh_token
# Only this machine by default. To reach it from the network turn the network mode on (every request then needs the access token, kept in the state folder) and say which name to use:
#MONITOR_LISTEN_NETWORK=1
#MONITOR_LISTEN_HOST=192.168.1.20
#MONITOR_ALLOWED_HOSTS=monitor.lan
# The port (8765 by default)
#MONITOR_PORT=8765
