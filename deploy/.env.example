# Copy to deploy/.env. Docker Compose reads it next to compose.yaml. Nothing here is a secret: the login of GitHub is the file deploy/gh_token.txt (a Docker secret).
# The user or organisation to watch (required). More accounts: set MONITOR_ACCOUNTS=personal:me,work:my-org instead.
MONITOR_GITHUB_OWNER=
# The language of the texts (en es de fr it ja zh pt); empty = the one of the system
MONITOR_LANG=
# The port published on 127.0.0.1 of this machine
MONITOR_PORT=8765
# 1 = the team mode (users, roles and sessions); the first administrator is created at /login from this machine
MONITOR_TEAM_MODE=

# --- only with the reverse proxy (docker compose --profile proxy up -d) ---
# What Caddy serves: a public name, a name of your network, or http://name for plain HTTP (see deploy/Caddyfile)
MONITOR_SITE=
# The public name again (HTTPS forms) and 1 for the cookie of an HTTPS session
MONITOR_PUBLIC_HOST=
MONITOR_SECURE_COOKIE=
# Plain HTTP form only: the name the browser uses, without scheme
MONITOR_ALLOWED_HOSTS=
