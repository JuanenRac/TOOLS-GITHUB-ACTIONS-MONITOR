{
  "_author": "Copyright (C) 2026 JuanenRac (Electro Hobby 3D) <electrohobby3d@gmail.com>",
  "_license": "GPL-3.0-or-later - see LICENSE",
  "name": "packages",
  "version": "1.0.0",
  "api_compat": "1",
  "author": "JuanenRac (Electro Hobby 3D)",
  "description": "Packages that keep more versions than the limit (retention). Releases and their files belong to the delivery sentinel and are not repeated here.",
  "trust": "official",
  "entry": "packages_plugin.py",
  "permissions": ["gh.get"],
  "get_paths": [
    "users/{owner}/packages?package_type=container",
    "orgs/{owner}/packages?package_type=container",
    "users/{owner}/packages/container/{name}/versions?per_page=100",
    "orgs/{owner}/packages/container/{name}/versions?per_page=100",
    "users/{owner}/packages?package_type=npm",
    "orgs/{owner}/packages?package_type=npm",
    "users/{owner}/packages/npm/{name}/versions?per_page=100",
    "orgs/{owner}/packages/npm/{name}/versions?per_page=100"
  ],
  "refresh_seconds": 86400
}
