  "runs": [
    {"repo": "queue-red", "id": 1, "path": "ci.yml", "branch": "main", "event": "push", "conclusion": "success", "hours": 30},
    {"repo": "queue-red", "id": 2, "path": "ci.yml", "branch": "QUEUE", "event": "merge_group", "conclusion": "failure", "hours": 2},
    {"repo": "queue-green", "id": 3, "path": "ci.yml", "branch": "main", "event": "push", "conclusion": "success", "hours": 30},
    {"repo": "queue-green", "id": 4, "path": "ci.yml", "branch": "QUEUE", "event": "merge_group", "conclusion": "success", "hours": 2},
    {"repo": "no-queue", "id": 5, "path": "ci.yml", "branch": "main", "event": "push", "conclusion": "success", "hours": 3}
  ]
}
