  {"path": "/api/report/tab.pdf", "reason": "a PDF file written by the monitor for this computer only (not a JSON document); the data of the same report is frozen under /api/report/tab"},
  {"path": "/api/ai/stream", "reason": "a stream of server-sent events, not a JSON document"},
  {"path": "/api/ai/prompts", "reason": "the local record of prompts and answers of the AI (an administrator only; empty and off until ai.prompt_log.enabled is turned on), a view of a file of this computer and not part of the read API"},
  {"path": "/api/assistant", "reason": "the description of the optional assistant (off by default, so the route answers 404 until it is turned on): its fixed actions, its closed list of tools and its limits; it spends nothing and grows with the assistant"},
  {"path": "/api/screens/menu", "reason": "the catalogue of the Screens menu of the page: addresses and parameters of the screens, made for that menu and not a contract for other readers"},
  {"path": "/api/screens/data", "reason": "what the wall screens draw: a closed list of fields that follows the screen asked for (?screen=overview|now|sentinels) and is made for those pages, not for other readers"},
 {"path": "/api/screens/logo", "reason": "the image of the logo of the organization (PNG, JPEG, WebP or SVG), not a JSON document"},
 {"path": "/api/screens/logo/info", "reason": "whether a logo was uploaded, for the Settings page: a few fields that follow the page and not a contract for other readers"},
  {"path": "/api/github-app/status", "reason": "state of the GitHub App of the account; its keys depend on the setup"},
  {"path": "/api/github-token", "reason": "state of the credential; its keys depend on the store in use"},
  {"path": "/api/live-events/stream", "reason": "a stream of server-sent events, not a JSON document"},
  {"path": "/api/compare", "reason": "the comparison of periods, off by default: the keys of the answer follow its state (off, calibrating, baseline unavailable, compared); it is frozen with the next widening of the contract"},
  {"path": "/api/otlp", "reason": "an export format of another standard"},
 {"path": "/api/team/fleet", "reason": "the fleet view whose rows depend on the settings of the grouping; it is frozen with the next widening of the contract"},
 {"path": "/api/runners/model", "reason": "an opt-in model of the runners whose keys depend on the settings; it is frozen with the next widening of the contract"},
  {"path": "/api/outputs/", "reason": "files for Prometheus and Grafana, in the format of those tools"},
  {"path": "/api/repos/", "reason": "the 200 answer is frozen in fed_endpoints (it needs a repository); its 404 above"},
  {"path": "/api/report-files/file", "reason": "the content of one report file, not a JSON document"},
  {"path": "/api/run-log", "reason": "text of the log of one run"},
  {"path": "/api/sentinel/parte.txt", "reason": "plain text or markdown of the daily report"},
  {"path": "/api/updates/copies", "reason": "the copies in the folder of copies of this installation: empty on one that was never updated"},
  {"path": "/api/updates/history", "reason": "the updates done on this installation: empty on a new one"},
  {"path": "/api/updates/log", "reason": "the last lines of the log of the process of the last update: empty until one ran"},
  {"path": "/api/updates/progress", "reason": "the progress file of the process that applies an update: it exists only while one runs or after it ran"},
  {"path": "/api/updates/status", "reason": "the state of the Updates menu: the version found, the switches and the progress of an update depend on the installation and on what GitHub says"},
  {"path": "/api/updates/stream", "reason": "server-sent events with the progress of an update: a stream, not a document with a frozen shape (the frames carry the JSON of /api/updates/progress)"},
  {"path": "/api/clone-anomalies", "reason": "the clones that behave in an unexpected way: new in this version, its shape stays free until it has been used for one release"},
  {"path": "/api/devices", "reason": "the phones paired with the monitor (an administrator only): a view of a local record, not part of the read API"},
  {"path": "/api/expected-red", "reason": "the workflows that are expected to be red: new in this version, its shape stays free until it has been used for one release"},
  {"path": "/api/glossary", "reason": "the terms of the glossary of the page, text for people"},
  {"path": "/api/meta-columns", "reason": "the metadata columns of the fleet view: new in this version, its shape stays free until it has been used for one release"},
  {"path": "/api/pair/status", "reason": "the state of the pairing of a phone (QR code): a one-time exchange, not a document with a frozen shape"},
  {"path": "/api/whats-new", "reason": "what is new since the last visit, text for people"},
  {"path": "/metrics", "reason": "the Prometheus text format"},
