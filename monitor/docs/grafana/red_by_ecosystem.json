 "_author": "Copyright (C) 2026 JuanenRac (Electro Hobby 3D) <electrohobby3d@gmail.com>",
 "_license": "GPL-3.0-or-later - see LICENSE",
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "description": "The Prometheus that scrapes http://127.0.0.1:PORT/metrics of the monitor",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "GitHub Actions monitor - red by ecosystem",
 "uid": "ghamon-red-by-ecosystem",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "tags": [
  "github-actions",
  "ci"
 ],
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Red workflows by ecosystem",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "ghamon_ecosystem_red_workflows",
     "legendFormat": "{{ecosystem}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 70,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  }
 ]
}
